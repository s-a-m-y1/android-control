/* Android Control — modern dark theme */

* {
    font-family: "Ubuntu", "Segoe UI", "Noto Sans", sans-serif;
}

QMainWindow, QDialog {
    background: #14161c;
}

QWidget {
    background: transparent;
    color: #e8eaf0;
    font-size: 13px;
}

/* ---------- Menu bar / toolbar ---------- */
QMenuBar {
    background: #1a1d26;
    border-bottom: 1px solid #2a2e3a;
    padding: 2px;
}
QMenuBar::item {
    padding: 6px 12px;
    border-radius: 6px;
}
QMenuBar::item:selected { background: #2a2e3a; }
QMenu {
    background: #1e2230;
    border: 1px solid #2a2e3a;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 24px 7px 14px;
    border-radius: 6px;
}
QMenu::item:selected { background: #3d7eff; color: white; }
QMenu::separator {
    height: 1px;
    background: #2a2e3a;
    margin: 5px 8px;
}
QToolBar {
    background: #1a1d26;
    border-bottom: 1px solid #2a2e3a;
    spacing: 4px;
    padding: 3px;
}
QToolBar QToolButton {
    background: transparent;
    color: #c6cbd8;
    border-radius: 6px;
    padding: 5px 10px;
}
QToolBar QToolButton:hover { background: #2a2e3a; color: white; }

/* ---------- Labels ---------- */
QLabel { background: transparent; }
QLabel[role="title"] {
    font-size: 19px;
    font-weight: 700;
    color: #f4f6fb;
}
QLabel[role="muted"] { color: #8b93a7; }
QLabel[role="chip"] {
    color: #8b93a7;
    font-size: 11px;
    border: 1px solid #2a2e3a;
    border-radius: 10px;
    padding: 3px 10px;
    background: #1a1d26;
}

/* ---------- Buttons ---------- */
QPushButton {
    background: #262b38;
    color: #e8eaf0;
    border: 1px solid #333950;
    border-radius: 9px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton:hover { background: #303855; border-color: #3d7eff; }
QPushButton:pressed { background: #232840; }
QPushButton:disabled { color: #565d73; background: #1c1f29; }
QPushButton[variant="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3d7eff, stop:1 #2f66e0);
    border: none;
    color: white;
    padding: 10px 26px;
    font-weight: 700;
}
QPushButton[variant="primary"]:hover { background: #4c88ff; }
QPushButton[variant="primary"]:pressed { background: #2f66e0; }
QPushButton[variant="danger"] {
    background: transparent;
    border: 1px solid #ff5f56;
    color: #ff5f56;
}
QPushButton[variant="danger"]:hover { background: #3a2326; }

/* ---------- Inputs ---------- */
QLineEdit, QSpinBox, QComboBox, QPlainTextEdit {
    background: #1a1d26;
    border: 1px solid #2a2e3a;
    border-radius: 8px;
    padding: 6px 10px;
    color: #e8eaf0;
    selection-background-color: #3d7eff;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #3d7eff; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: #1e2230;
    border: 1px solid #2a2e3a;
    border-radius: 8px;
    selection-background-color: #3d7eff;
    selection-color: white;
    outline: none;
}
QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border-radius: 5px;
    border: 1px solid #333950;
    background: #1a1d26;
}
QCheckBox::indicator:checked { background: #3d7eff; border-color: #3d7eff; }

/* ---------- Group / frames / scroll ---------- */
QGroupBox {
    background: #181b24;
    border: 1px solid #2a2e3a;
    border-radius: 12px;
    margin-top: 14px;
    padding: 10px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #aab3c7;
}
QFrame[role="card"] {
    background: #181b24;
    border: 1px solid #2a2e3a;
    border-radius: 14px;
}
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #333950;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #3d7eff; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; }
QScrollBar::handle:horizontal {
    background: #333950;
    border-radius: 4px;
    min-width: 24px;
}

/* ---------- Status bar ---------- */
QStatusBar {
    background: #1a1d26;
    border-top: 1px solid #2a2e3a;
    color: #8b93a7;
}
QStatusBar::item { border: none; }

/* ---------- Message boxes ---------- */
QMessageBox { background: #1e2230; }
QMessageBox QLabel { color: #e8eaf0; }
