[Desktop Entry]
Name=Android Control
Comment=Mirror and control Android devices via USB (ADB + scrcpy)
GenericName=Android Screen Mirroring
Exec=android-control
Icon=android-control
Terminal=false
Type=Application
Categories=Utility;Development;Phone;
Keywords=android;adb;scrcpy;mirror;phone;usb;
StartupWMClass=android-control
StartupNotify=true
Actions=Settings;

[Desktop Action Settings]
Name=Open Settings
Exec=android-control --settings
